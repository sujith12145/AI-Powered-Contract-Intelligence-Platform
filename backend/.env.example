# ============================================================
# ContractIQ — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- App ----
APP_NAME=ContractIQ
ENVIRONMENT=development            # development | staging | production
DEBUG=false

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_32_byte_random_secret

# JWT settings (HS256 by default — set PRIVATE/PUBLIC key for RS256)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional RS256 keys (PEM format, single line with \n)
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# ---- Database ----
# SQLite (default — zero config, great for dev):
DATABASE_URL=sqlite+aiosqlite:///./contractiq.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://contractiq:password@localhost:5432/contractiq
DB_ECHO=false

# ---- Redis (optional) ----
# Leave empty to use in-memory fallback (not recommended for production)
# REDIS_URL=redis://localhost:6379/0

# ---- CORS ----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ---- Rate Limiting ----
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_ANALYZE=20/hour
RATE_LIMIT_ASSISTANT=30/minute
RATE_LIMIT_DEFAULT=200/minute

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ---- CUAD / ChromaDB ----
# CUAD_CSV_PATH=/path/to/master_clauses.csv    # auto-detected if not set
# CHROMA_DIR=./.chroma_store

# ---- Default Admin Account ----
# Created automatically on first startup. CHANGE THE PASSWORD!
ADMIN_EMAIL=admin@contractiq.local
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Administrator
