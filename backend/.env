# ---- App ----
APP_NAME=ContractIQ
ENVIRONMENT=development
DEBUG=true

# ---- Security ----
SECRET_KEY=45d5a7d65bbfa89b21ea7f7d6a7a01d67d7120a16ef3a8e9803bcf52467d549f
# Audit-log HMAC signing key — never stored in the database.
# Replace with a strong random hex in production: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_LOG_HMAC_KEY=9e3b8f2a1c7d4e6f0a5b9c2d7e8f3a4b6c1d2e5f0a7b8c9d3e4f5a6b7c8d9e0f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./contractiq.db
DB_ECHO=false

# ---- CORS ----
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:5188"]

# ---- Rate Limiting ----
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_ANALYZE=60/hour
RATE_LIMIT_ASSISTANT=100/minute
RATE_LIMIT_DEFAULT=1000/minute

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ---- Default Admin Account ----
ADMIN_EMAIL=admin@contractiq.local
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Administrator
